# Ejemplo de local.properties
#
# Copiá este archivo a `local.properties` y completá los valores reales.
# `local.properties` NO se versiona (está en .gitignore): cada miembro del
# equipo debe crear el suyo en su máquina.
#
#   cp local.properties.example local.properties
#
# Los valores reales de las keys (los mismos cargados en los GitHub Secrets)
# deben pasarse por un canal seguro, nunca por el repo.

# Ruta del Android SDK (ajustala a tu instalación local)
sdk.dir=/ruta/a/tu/Android/sdk

# URL base del backend
# Emulador:         http://10.0.2.2:8000/api/
# Dispositivo físico: http://192.168.x.x:8000/api/
# Producción:       https://vaia-api-...azurewebsites.net/api/
API_BASE_URL=http://10.0.2.2:8000/api/

# API key de Google Maps / Places
MAPS_API_KEY=tu_api_key_de_google_maps

# Client ID de OAuth para el Sign-In de Google Drive
GOOGLE_DRIVE_CLIENT_ID=tu_oauth_client_id
